# Jasama environment template
# Copy values from the appropriate local or deployment secret manager.
# Never commit populated secrets.

# Public browser variables (safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://replace-with-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-public-publishable-key

# Server-only Supabase variable (never expose to browser code)
SUPABASE_SECRET_KEY=replace-with-server-only-secret-key

# Deployment environment
# Allowed: development, test, staging, production.
APP_ENV=replace-with-development-test-staging-or-production

# Trusted server-side application URL used only to build Auth email callbacks.
# Localhost/127.0.0.1 is allowed only in development and test.
APP_BASE_URL=https://replace-with-application-origin.example

# Mock-payment kill switch
# Replace with disabled, or mock only in an approved non-production environment.
# Production configuration and startup validation must reject PAYMENT_MODE=mock.
PAYMENT_MODE=replace-with-disabled-or-mock

# Private-address encryption (server-only)
# Store every key version in a deployment secret manager, never in source control.
# Rotate by adding a new version, updating the active version, then re-encrypting
# under controlled jobs while retaining old keys only as long as decryption needs them.
PRIVATE_ADDRESS_KEY_VERSION=replace-with-positive-key-version
PRIVATE_ADDRESS_KEY_V1_BASE64=replace-with-base64-encoded-32-byte-key

# Scheduled-job recovery authentication (server-only)
INTERNAL_JOB_RECOVERY_SECRET=replace-with-random-recovery-secret

# Future integrations are commented out and may be enabled only after the
# corresponding product decision, security review, implementation, and test
# gate are approved.
# SMS_PROVIDER=disabled
# SMS_PROVIDER_API_KEY=replace-only-after-provider-approval
# MALWARE_SCANNER_PROVIDER=disabled
# MALWARE_SCANNER_API_KEY=replace-only-after-validator-approval
# REAL_PAYMENT_PROVIDER=disabled
# REAL_PAYMENT_PROVIDER_SECRET=replace-only-after-payment-approval
# IDENTITY_VERIFICATION_PROVIDER=disabled
# IDENTITY_VERIFICATION_PROVIDER_SECRET=replace-only-after-policy-approval
